NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://monabid:monabid@localhost:5432/monabid
FIXTURE_SET=default
LOCAL_STORAGE_PATH=../../.local-storage
LOG_LEVEL=info

# AI provider (P4). Full reference: docs/ai-provider-handoff.md
# fixture = deterministic answers, no network (CI and default). real = call the hosted model below.
AI_PROVIDER_MODE=fixture
# Any OpenAI-compatible base URL; the backend calls <AI_BASE_URL>/chat/completions.
AI_BASE_URL=https://api.openai.com/v1
# Project-owner selected model. Strict JSON-schema output is used only for gpt-4o, gpt-4o-mini
# and gpt-4.1* on api.openai.com (and openai/gpt-oss-* on api.groq.com); other models use json_object.
AI_MODEL_NAME=gpt-4o-mini
# Server-side only. Never put it in the client .env, a fixture, a log or a commit.
AI_API_KEY=
# Optional. Abort a provider call after this many ms (default 20000); a timeout is not retried.
# AI_TIMEOUT_MS=20000

# Buyer bridge (B2) and seller intake (S1) call this backend's AI endpoint.
AI_GENERATE_URL=http://localhost:3001/api/ai/generate
# Optional bearer token for AI_GENERATE_URL. When unset, AI_API_KEY is sent instead,
# so keep AI_GENERATE_URL on this backend.
# AI_GENERATE_API_KEY=
