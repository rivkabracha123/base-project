NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://monabid:monabid@localhost:5432/monabid
FIXTURE_SET=default
LOCAL_STORAGE_PATH=../../.local-storage
LOG_LEVEL=info
